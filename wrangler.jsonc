{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warmdiet-platform",
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true
  },
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
