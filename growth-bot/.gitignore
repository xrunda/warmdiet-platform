# 依赖与构建产物
node_modules/
dist/

# 私有本机配置：只允许提交 *.example.json
config/project.json
config/platforms.json
config/paths.json
config/*.local.json
paths.local.json
*.local.json

# 密钥、Cookie、Token 一律不入库
.env
.env.*
!.env.example
*.pem
*.key
cookies*.json
tokens*.json

# 每日生成的派生数据不入库（目录结构由 .gitkeep 保留）
data/project-state/*.json
data/trends/*.json
# 每日热点源文件为本地运营数据，仅提交 example 模板
data/trends/source/*.json
!data/trends/source/example.json

# 系统文件
.DS_Store
